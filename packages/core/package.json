{
  "name": "@vega-ui/core",
  "version": "3.0.0",
  "description": "Framework-free models that @vega-ui components are built from",
  "license": "MIT",
  "keywords": [
    "ui-kit",
    "ui",
    "headless",
    "ts",
    "typescript",
    "js"
  ],
  "author": "VegaUI Team",
  "bugs": {
    "url": "https://github.com/vega-ui/ui/issues"
  },
  "homepage": "https://github.com/vega-ui/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vega-ui/ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./test": {
      "source": "./src/test/index.ts",
      "import": {
        "types": "./dist/test/index.d.ts",
        "default": "./dist/test.js"
      }
    }
  },
  "files": [
    "dist/*"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check-types": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.0.0"
}
