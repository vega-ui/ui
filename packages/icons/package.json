{
  "name": "@vega-ui/icons",
  "version": "2.4.0",
  "description": "Icons for Vega UI Kit for Web",
  "license": "MIT",
  "keywords": [
    "ui-kit",
    "ui",
    "ts",
    "typescript",
    "js"
  ],
  "author": "VegaUI Team",
  "bugs": {
    "url": "https://github.com/vega-ui/ui/issues"
  },
  "homepage": "https://github.com/vega-ui/ui#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./Flag*": {
      "types": "./svg.d.ts",
      "import": "./dist/assets/flags/*.svg.js"
    },
    "./*": {
      "types": "./svg.d.ts",
      "import": "./dist/assets/icons/*.svg.js"
    }
  },
  "files": [
    "dist/*",
    "svg.d.ts"
  ],
  "scripts": {
    "generate": "node --experimental-strip-types ./scripts/generate-icons.mts",
    "dev": "pnpm generate && vite build --watch",
    "build": "pnpm generate && vite build",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.23.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "sideEffects": false,
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.0.0"
}
