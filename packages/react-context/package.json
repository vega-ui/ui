{
  "name": "@vega-ui/react-context",
  "version": "2.1.1",
  "description": "Context utils for @vega-ui/react",
  "license": "MIT",
  "keywords": [
    "ui-kit",
    "ui",
    "ts",
    "typescript",
    "js"
  ],
  "author": "VegaUI Team",
  "bugs": {
    "url": "https://github.com/vega-ui/ui/issues"
  },
  "homepage": "https://github.com/vega-ui/ui#readme",
  "type": "module",
  "main": "./dist/index.ts",
  "exports": {
