{
  "name": "@vega-ui/react-kit",
  "version": "2.5.0",
  "description": "React utils for building @vega-ui components",
  "license": "MIT",
  "keywords": [
    "ui-kit",
    "ui",
    "ts",
    "typescript",
    "js"
  ],
  "author": "VegaUI Team",
  "bugs": {
    "url": "https://github.com/vega-ui/ui/issues"
  },
  "homepage": "https://github.com/vega-ui/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vega-ui/ui.git",
    "directory": "packages/react-kit"
  },
  "type": "module",
  "exports": {
    "./context": {
      "source": "./src/context/index.ts",
      "import": {
        "types": "./dist/context/index.d.ts",
        "default": "./dist/context/index.js"
      }
    },
    "./registry": {
      "source": "./src/registry/index.ts",
      "import": {
        "types": "./dist/registry/index.d.ts",
        "default": "./dist/registry/index.js"
      }
    },
    "./store": {
      "source": "./src/store/index.ts",
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      }
    }
  },
  "files": [
    "dist/*"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.0.0"
}
