{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "paths": {
      "@vega-ui/utils": ["./packages/utils/src/index.ts"],
      "@vega-ui/utils/*": ["./packages/utils/src/*"],
      "@vega-ui/hooks": ["./packages/hooks/src/index.ts"],
      "@vega-ui/hooks/*": ["./packages/hooks/src/*"],
      "@vega-ui/icons/*": ["./packages/icons/src/*"],
      "@vega-ui/icons": ["./packages/icons/src/index.ts"],
      "@vega-ui/react": ["./packages/ui/src/index.ts"],
      "@vega-ui/react/*": ["./packages/ui/src/*"],
      "@vega-ui/core": ["./packages/core/src/index.ts"],
      "@vega-ui/core/test": ["./packages/core/src/test/index.ts"],
      "@vega-ui/widgets/*": ["./packages/widgets/src/*/index.ts"],
      "@vega-ui/i18n": ["./packages/i18n/src/index.ts"],
      "@vega-ui/i18n/*": ["./packages/i18n/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
