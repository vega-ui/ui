{
  "compilerOptions": {
    "jsx": "react",
    "esModuleInterop": true,
    "paths": {
      "@vega-ui/utils": ["./packages/utils/src/index.ts"],
      "@vega-ui/utils/*": ["./packages/utils/src/*"],
      "@vega-ui/hooks": ["./packages/hooks/src/index.ts"],
      "@vega-ui/hooks/*": ["./packages/hooks/src/*"],
      "@vega-ui/icons/*": ["./packages/icons/src/*"],
      "@vega-ui/icons": ["./packages/icons/src/index.ts"],
      "@vega-ui/react": ["./packages/ui/src/index.ts"],
      "@vega-ui/react/*": ["./packages/ui/src/*"],
      "@vega-ui/react-context": ["./packages/react-context/src/index.ts"],
      "@vega-ui/react-context/*": ["./packages/react-context/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
